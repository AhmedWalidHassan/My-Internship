# Container-only DEFAULTS, loaded before week1/.env (which overrides anything here).
# No secrets in this file: it is committed.

# Where the host's Ollama is, seen from inside a container (compose maps
# host.docker.internal to the host). Ollama must listen beyond loopback for this:
# start it with OLLAMA_HOST=0.0.0.0 (see README). Ignored unless LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
