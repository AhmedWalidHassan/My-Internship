# --- models (defaults match a local Ollama setup) ---
LLM_PROVIDER=ollama          # ollama | openai | groq
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434
EMBED_PROVIDER=hf
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # use whatever you used in Task 3

# --- retrieval ---
RETRIEVER_MODE=hybrid        # hybrid | mmr | similarity
# DATA_DIR=../data           # defaults to ../data if it has .md files, else ./sample_data

# --- LangSmith tracing + evals (required for the eval experiments and 👍/👎 feedback) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=northwind-capstone
