# -------- Copy this file to `.env` and fill in your keys. Do NOT commit `.env`. --------
# This one file configures everything: the CLI, the API (`make run`) and the containers
# (`make up` passes it to docker compose at runtime; it is never copied into an image).
# All settings are typed and validated at startup: see week1/common/settings.py.

# ======== Provider: switching = editing this block only ========
# LLM_PROVIDER: openai | groq | ollama | huggingface
# EMBEDDING_PROVIDER: openai, or ollama | groq | huggingface (all = the local HF_EMBED_MODEL)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# --- OpenAI (default code path) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=                      # unset = the official OpenAI API
# OPENAI_REASONING_EFFORT=              # unset = not sent. `none` for a THINKING model behind an
#                                       # OpenAI-compatible server (e.g. qwen3.5 via Ollama's /v1):
#                                       # otherwise each one-word grader call "thinks" ~1,000 tokens

# --- OpenRouter: it's OpenAI-compatible, so LLM_PROVIDER=openai + its base URL ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
# EMBEDDING_PROVIDER=huggingface        # OpenRouter has no embeddings API

# --- Groq ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=                        # unset = the official Groq API
# EMBEDDING_PROVIDER=groq               # = local HF embeddings (Groq has no embeddings API)

# --- Ollama (local, no key) ---
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=                      # unset = http://localhost:11434. In docker compose the
#                                       # default is the host's Ollama (container.env); leave it unset.

# --- Hugging Face Inference ---
# HUGGINGFACEHUB_API_TOKEN=hf_...
# HF_MODEL=HuggingFaceH4/zephyr-7b-beta
# HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ======== Retrieval & index (changing chunking or the embedding model rebuilds the index) ========
# RETRIEVER_K=4                         # passages per retriever (BM25 and dense)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# INDEX_PATH=                           # default: capstone_internal_docs_assistant/faiss_index
#                                       # (in docker: /data/faiss_index, a named volume; not overridable)
# DATA_DIR=                             # default: week1/data

# ======== Service ========
# API_HOST=127.0.0.1                    # the API has no auth: keep it local (docker uses 0.0.0.0 inside)
# API_PORT=8000
# SESSION_TTL_SECONDS=3600
# MAX_SESSIONS=10000
# MAX_QUESTION_CHARS=2000
# LOG_LEVEL=INFO

# -------- LangSmith (tracing, eval, /feedback) --------
# Get a free key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_PROJECT=rag-internship
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
