# -------- Copy this file to `.env` and fill in your keys. Do NOT commit `.env`. --------

# Pick ONE primary provider (default code path uses OpenAI).
OPENAI_API_KEY=sk-...

# Optional alternative providers -------------------------------------------------
# GROQ_API_KEY=gsk_...
# HUGGINGFACEHUB_API_TOKEN=hf_...
# (Ollama needs no key — just run `ollama serve` locally.)

# Which provider the shared helpers should use: openai | groq | ollama | huggingface
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# Model names and endpoints (all optional; defaults shown) ------------------------
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=                      # unset = official OpenAI API
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama|groq|huggingface all use this local sentence-transformers model:
# HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LOG_LEVEL=INFO                        # capstone log lines (index built / loaded)

# -------- LangSmith (needed from Task 7 onward) --------
# Get a free key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=rag-internship
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
